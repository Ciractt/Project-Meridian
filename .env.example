# Duffel — Phase 2. Sandbox tokens start with duffel_test_.
# Server-only. Never prefix with NEXT_PUBLIC_.
DUFFEL_API_TOKEN=

# Webhook signing secret, from Duffel Dashboard → Webhooks. Without it the
# webhook endpoint rejects everything, which means airline schedule changes go
# unnoticed and any order that came back 202 is never resolved.
DUFFEL_WEBHOOK_SECRET=

# Supabase. The anon key is public by design — every table it reaches is
# protected by row-level security. Run supabase/migrations/0001_*.sql first.
NEXT_PUBLIC_SUPABASE_URL=
# Projects created from Nov 2025 onward have a publishable key and no anon key.
# The local CLI stack still prints an anon key. Either variable works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Server-only — never in a NEXT_PUBLIC_ variable.
# Required by the search cache and the admin stats screens, which read tables
# no user session is allowed to touch. New projects issue sb_secret_...;
# older ones have a service_role JWT. Either variable name works.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Booking economics. Charge = (fare + margin) / (1 - assumed fee rate).
# The fee rate must be assumed because it depends on the card's country of
# issue, which isn't known until after the charge amount is fixed. Grossing up
# at the higher rate means European cards earn slightly more rather than
# non-European cards losing money.
# Margin on flights.
BOOKING_MARGIN_RATE=0.05

# Margin on bags and seats, which carry more headroom than fares. This rate is
# ALSO handed to Duffel's ancillaries component as its markup, so the price shown
# next to a bag is the price it adds to the total. Change it here only — the two
# must agree.
BOOKING_EXTRAS_MARGIN_RATE=0.15

BOOKING_ASSUMED_FEE_RATE=0.029
